# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Base MySQL (schéma : db/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ouvrage_app
DB_PASSWORD=changez-moi
DB_NAME=ouvrage
# TLS : true pour un MySQL managé (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# Un secret différent par espace : au moins 32 caractères aléatoires
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SECRET_PRO=
JWT_SECRET_ADMIN=
PAYMENT_WEBHOOK_SECRET=

# Clés de 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOC_ENCRYPTION_KEY=
ADMIN_SECRETS_KEY=

# Dossier des pièces chiffrées, hors du dossier public, réservé au service
DOC_STORAGE_DIR=/var/lib/ouvrage/documents

# Origines des applications mobiles (Capacitor / Ionic)
CORS_ORIGINS=capacitor://localhost,https://localhost

# Optionnel : adresses IP autorisées pour l'administration (séparées par des virgules)
ADMIN_IP_ALLOWLIST=

MIN_WITHDRAWAL=1000
DISTRIBUTION_SIZE=3
