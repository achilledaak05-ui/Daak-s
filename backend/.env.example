# Copier en .env pour le développement local. Sur Render, ces valeurs se règlent dans le tableau de bord.
NODE_ENV=development
PORT=3000

# --- Base MySQL ---
# Aiven : copier la « Service URI » (mysql://avnadmin:...@...aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED)
DATABASE_URL=mysql://root:@127.0.0.1:3306/ouvrage
# Aiven : coller le contenu du certificat « CA certificate » (-----BEGIN CERTIFICATE----- ...).
# Laisser vide en local sans TLS.
DB_SSL_CA=

# --- Secrets : 32 caractères aléatoires minimum chacun ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Chiffre les pièces des prestataires et les secrets TOTP. NE JAMAIS LE CHANGER une fois en production.
DATA_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Paiements ---
# disabled : paiements refusés (503) tant qu'aucun prestataire n'est branché
# sandbox  : paiement validé immédiatement, pour tester l'application de bout en bout
PAYMENTS_MODE=disabled

# Origines autorisées en CORS (applications mobiles Capacitor). Les pages web sont sur la même origine.
CORS_ORIGINS=capacitor://localhost,https://localhost
# Optionnel : IP autorisées pour l'administration, séparées par des virgules
ADMIN_IP_ALLOWLIST=

MIN_WITHDRAWAL=1000
DISTRIBUTION_SIZE=3
